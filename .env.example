# Copy to .env.production.local (or set in the hosting dashboard) once each
# value is approved. Every NEXT_PUBLIC_ value is inlined at build time, so a
# change needs a rebuild.

# RentReadBuy platform origin for every outbound link.
NEXT_PUBLIC_RRB_BASE_URL=https://rentreadbuy.com

# Approved production origin of this campaign page, e.g. https://<subdomain>.rentreadbuy.com
# Leave empty until the hostname is approved: canonical, og:url, og:image,
# sitemap and JSON-LD URLs are omitted while it is unset.
NEXT_PUBLIC_SITE_URL=

# RentReadBuy's existing container is GTM-MRLNJ7Q. Leave empty until consent
# handling and duplicate tracking have been checked in GTM Preview.
NEXT_PUBLIC_GTM_ID=

# on  = copy landing UTMs and ad click IDs onto RentReadBuy links (separate GA4 property)
# off = do not copy them (this page shares RentReadBuy's GA4 property)
NEXT_PUBLIC_ATTRIBUTION_PASSTHROUGH=on

# Shared visitor chat (widget 1.1.0), operated by Primewayz Infotech.
# Leave ENABLED=off until https://join.rentreadbuy.com is registered for this
# site key and activation is approved. The API host below is the technical
# endpoint; it is not the visitor-facing service name.
# Chat stays off unless ENABLED is on/true and both URLs below are valid https
# values (or a same-origin widget path).
# on or true = show the chat privacy notice. The widget script loads only after
# the visitor opens chat. Anything else (or unset) = no notice, no widget script
# and no chat request.
NEXT_PUBLIC_SHARED_CHAT_ENABLED=off
# Public chat API. https only, no credentials, query or fragment.
NEXT_PUBLIC_SHARED_CHAT_API_BASE_URL=https://uk.primewayz.com
# Published pw-chat.js. With the integrity hash below, the loader sets crossorigin="anonymous".
NEXT_PUBLIC_SHARED_CHAT_WIDGET_URL=https://uk.primewayz.com/embed/chat/1.1.0/pw-chat.js
# SRI hash of widget 1.1.0 (48812 bytes, sha256 d31a1ef3dc9794524b554455ba1dc865605907f8132c70cfbc56e920eba0681f).
NEXT_PUBLIC_SHARED_CHAT_WIDGET_INTEGRITY=sha384-NoTM6nKvWU6U4TPvQ2rbNTuxv6aP4fj8BWZBSG5XIDPPuz9IhKp1EjwJ3BNOo4XO
