# Copy to .env.production.local (or set in the hosting dashboard) once each
# value is approved. Every NEXT_PUBLIC_ value is inlined at build time, so a
# change needs a rebuild.

# RentReadBuy platform origin for every outbound link.
NEXT_PUBLIC_RRB_BASE_URL=https://rentreadbuy.com

# Approved production origin of this campaign page, e.g. https://<subdomain>.rentreadbuy.com
# Leave empty until the hostname is approved: canonical, og:url, og:image,
# sitemap and JSON-LD URLs are omitted while it is unset.
NEXT_PUBLIC_SITE_URL=

# RentReadBuy's existing container is GTM-MRLNJ7Q. Leave empty until consent
# handling and duplicate tracking have been checked in GTM Preview.
NEXT_PUBLIC_GTM_ID=

# on  = copy landing UTMs and ad click IDs onto RentReadBuy links (separate GA4 property)
# off = do not copy them (this page shares RentReadBuy's GA4 property)
NEXT_PUBLIC_ATTRIBUTION_PASSTHROUGH=on

# Shared Primewayz visitor chat (widget 1.1.0). Leave off until Primewayz has
# registered this page's exact origin. Chat stays off unless ENABLED is on/true
# and both URLs below are valid https values (or a same-origin widget path).
# on or true = load the shared widget; anything else (or unset) = no widget script and no chat request.
NEXT_PUBLIC_SHARED_CHAT_ENABLED=off
# Primewayz public chat API. https only, no credentials, query or fragment.
# Preview: https://uk.primewayz.com
NEXT_PUBLIC_SHARED_CHAT_API_BASE_URL=
# Versioned pw-chat.js (https URL), or a same-origin path if a copy is served from /public.
# Preview: https://uk.primewayz.com/embed/chat/1.1.0/pw-chat.js
NEXT_PUBLIC_SHARED_CHAT_WIDGET_URL=
# Optional SRI hash of that exact pw-chat.js build (sha256, sha384 or sha512).
# Widget 1.1.0 (48812 bytes, sha256 d31a1ef3dc9794524b554455ba1dc865605907f8132c70cfbc56e920eba0681f):
# sha384-NoTM6nKvWU6U4TPvQ2rbNTuxv6aP4fj8BWZBSG5XIDPPuz9IhKp1EjwJ3BNOo4XO
NEXT_PUBLIC_SHARED_CHAT_WIDGET_INTEGRITY=
