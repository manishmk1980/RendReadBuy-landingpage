# Copy to .env.production.local (or set in the hosting dashboard) once each
# value is approved. Every NEXT_PUBLIC_ value is inlined at build time, so a
# change needs a rebuild.

# RentReadBuy platform origin for every outbound link.
NEXT_PUBLIC_RRB_BASE_URL=https://rentreadbuy.com

# Approved production origin of this campaign page, e.g. https://<subdomain>.rentreadbuy.com
# Leave empty until the hostname is approved: canonical, og:url, og:image,
# sitemap and JSON-LD URLs are omitted while it is unset.
NEXT_PUBLIC_SITE_URL=

# Confirmed container: GTM-MRLNJ7Q (live version 17). Leave empty until this
# build is the approved release. When set, gtm.js is requested only after the
# visitor grants both analytics and advertising. Partial consent does not load
# it, because the published Meta tags do not read Consent Mode.
NEXT_PUBLIC_GTM_ID=

# on  = copy landing UTMs and ad click IDs onto RentReadBuy links (separate GA4 property)
# off = do not copy them (this page shares RentReadBuy's GA4 property)
NEXT_PUBLIC_ATTRIBUTION_PASSTHROUGH=on

# Shared visitor chat (widget 1.3.0), operated by Primewayz Infotech.
# Origin https://join.rentreadbuy.com is registered for site key
# rentreadbuy-silver (tenant rrb-silver-campaign). Activation is approved.
# Do not reuse the general rrb or pw-uk tenants. The API host below is the
# technical endpoint; it is not the visitor-facing service name.
# ?pw_chat=open loads this same widget and lets it open itself. It does not
# start a second chatbot. Other query values do nothing.
# Chat stays off unless ENABLED is on/true and both URLs below are valid https
# values (or a same-origin widget path).
# on or true = show the chat privacy notice. The widget script loads only after
# the visitor opens chat. Anything else (or unset) = no notice, no widget script
# and no chat request.
NEXT_PUBLIC_SHARED_CHAT_ENABLED=on
# Public chat API. https only, no credentials, query or fragment.
NEXT_PUBLIC_SHARED_CHAT_API_BASE_URL=https://uk.primewayz.com
# Published pw-chat.js. With the integrity hash below, the loader sets crossorigin="anonymous".
NEXT_PUBLIC_SHARED_CHAT_WIDGET_URL=https://uk.primewayz.com/embed/chat/1.3.0/pw-chat.js
# SRI hash of widget 1.3.0 (49555 bytes, sha256 9155d04e0aabfb2b5ad1f0ba6db4fbf3577f43fc1e09d184ebfb84312bc5ad5a).
NEXT_PUBLIC_SHARED_CHAT_WIDGET_INTEGRITY=sha384-eViGVIdK7TNI/WYYpjF31NYjvzJEZ0sTcioyRIASbNuex4DHyjl0yRBYzCRfrEv4

# ---------------------------------------------------------------------------
# Silver chat operator login (server-only). Never use NEXT_PUBLIC_ for these.
# Fail closed: if any value is missing/invalid, /admin/login rejects and
# /admin redirects to login. Does not grant Host/Owner or cross-tenant access.
# Conversation APIs stay blocked until a Silver integration credential exists.
# ---------------------------------------------------------------------------
# Single campaign operator username.
CHAT_ADMIN_USERNAME=
# scrypt PHC-style hash (not plaintext). Generate locally — see README.
# Example shape only: $scrypt$n=16384,r=8,p=1$<salt>$<hash>
CHAT_ADMIN_PASSWORD_HASH=
# ≥32-byte secret for HMAC session + CSRF MACs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CHAT_ADMIN_SESSION_SECRET=
# Set to 1/true only when the edge proxy overwrites/strips client X-Forwarded-For.
# Leave unset so spoofed forwarding headers cannot bypass login throttling.
CHAT_ADMIN_TRUST_PROXY=
# Optional Upstash-compatible Redis REST endpoint. Required before multi-instance
# deploys so session revocation and login throttling are shared. Leave both unset
# for a single Node process (in-memory store).
CHAT_ADMIN_SHARED_STORE_URL=
CHAT_ADMIN_SHARED_STORE_TOKEN=
